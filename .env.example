# Backend Configuration
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Data Sources Configuration
NZ_AVALANCHE_API_URL=https://www.aac.org.nz
OPENWEATHER_API_KEY=your_openweather_api_key_here
OPENWEATHER_API_URL=https://api.openweathermap.org

# Default Location (New Zealand)
DEFAULT_LATITUDE=-41.2865
DEFAULT_LONGITUDE=172.8860

# Scheduling Configuration
FETCH_INTERVAL_MINUTES=60
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000

# Data Storage
DATA_STORAGE_PATH=./backend/data
LOG_PATH=./backend/logs

# Frontend Configuration
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_MAP_CENTER_LAT=-41.2865
REACT_APP_MAP_CENTER_LNG=172.8860
REACT_APP_MAP_ZOOM=6